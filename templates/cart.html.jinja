  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    
  </head>
  <body>
    {% include "components/navbar.html.jinja" %}
    
    <main class = "max-w-4xl mx-auto p-6 mb-5">
    <h1 class="text-3xl font-bold ">Your Cart</h1>


    {%for x in cart%}
    <div class = "row-span-2 row-end-3">
    <img src="{{x['Image']}}">
    {{x['Name']}}
          <div>
           <form method="post" action="/cart/{{x['ProductID']}}/update_qty">
           <input class="w-full" name="qty" type="number" value=" {{x['Quantity']}} ">
            <button type="submit">Update</button>
           </form>
          </div>
          <div>F{{x['Price']}} </div>
          <div>F{{x['Price']* x['Quanity']}}</div>
      </div>


    {%endfor%}
    </main>

</body>
</html>